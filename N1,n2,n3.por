programa {
  funcao inicio() {
  inteiro n1,n2,n3
  escreva("digite um valor n1")
  leia(n1)
  escreva("digite um valor n2")
  leia(n2)
  escreva("digite um valor n3")
  leia(n3)
  se (n1>n2 e n1>n3){     
    escreva("n1 é o maior")
  }
  senao{      
  se (n2>n1 e n2>n3){
    escreva("n2 é o maior")
  } 
  senao{
    escreva("n3 é o maior")
    }

  }
}
}